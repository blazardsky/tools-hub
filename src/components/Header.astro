---
import House from "@phosphor-icons/core/duotone/house-duotone.svg";
import { SITE_TITLE } from "../consts";
---

<header>
  <nav>
    <h2>
      <a href="/">
        <House width={20} height={20} aria-hidden="true" />
        {SITE_TITLE}
      </a>
    </h2>
  </nav>
</header>
<style>
  header {
    margin: 0;
    padding: 0 1em;
    background: var(--background);
    border-bottom: 1px solid var(--border);
  }
  h2 {
    margin: 0;
    font-size: 1em;
  }

  h2 a {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    text-decoration: none;
    color: var(--foreground);
  }
  h2 a:hover {
    color: var(--foreground);
    opacity: 0.8;
  }
  nav {
    display: flex;
    align-items: center;
  }
  nav a {
    padding: 1em 0.5em;
    text-decoration: none;
  }
</style>

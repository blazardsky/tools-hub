---
import App from "@components/openbadge-verifier/App";
import ToolLayout from "@layouts/ToolLayout.astro";

const title = "OpenBadge Verifier [BETA v0.2.0]";
---

<ToolLayout
  title={title}
  description="Verify Open Badges locally in your browser."
>
  <h1>{title}</h1>
  <p class="text-muted-foreground">
    Reads the credential baked into an Open Badges 3.0 image and checks whether
    it is still signed by the issuer it names.
  </p>
  <App client:load />
</ToolLayout>

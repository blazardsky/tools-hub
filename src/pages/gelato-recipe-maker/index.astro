---
import App from "@components/gelato-recipe-maker/App";
import ToolLayout from "@layouts/ToolLayout.astro";

const title = "Creatore Ricette Gelato";
---

<ToolLayout
  title={title}
  description="Genera quantità bilanciate di gelato e sorbetto in grammi."
>
  <h1>{title}</h1>
  <p>Bilancia una miscela dal peso della frutta (o dal totale per la base bianca), con additivi opzionali.</p>
  <App client:load />
</ToolLayout>

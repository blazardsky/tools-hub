---
import ToolLayout from "@layouts/ToolLayout.astro";
import CookingPot from "@phosphor-icons/core/duotone/cooking-pot-duotone.svg";
import IceCream from "@phosphor-icons/core/duotone/ice-cream-duotone.svg";
import NotePencil from "@phosphor-icons/core/duotone/note-pencil-duotone.svg";
import SealCheck from "@phosphor-icons/core/duotone/seal-check-duotone.svg";

const tools = [
  {
    href: "/openbadge-verifier",
    name: "OpenBadge Verifier (WIP)",
    description:
      "Verify Open Badges 3.0 JWTs cryptographically signed with ed25519.",
    Icon: SealCheck,
  },
  {
    href: "/quick-notes",
    name: "Quick Notes",
    description: "A fast notepad that saves in your browser.",
    Icon: NotePencil,
  },
  {
    href: "/recipe-converter",
    name: "Recipe Converter",
    description: "Convert recipe quantities and units.",
    Icon: CookingPot,
  },
  {
    href: "/gelato-recipe-maker",
    name: "Creatore Ricette Gelato (IN ITALIAN)",
    description: "Genera quantità bilanciate di gelato e sorbetto in grammi.",
    Icon: IceCream,
  },
] as const;
---

<ToolLayout
  title="Tools Hub"
  description="A collection of mixed tools that I find useful, and hopefully you will too."
>
  <h1>Tools Hub</h1>
  <p class="text-muted-foreground">
    A collection of mixed tools that I find useful, and hopefully you will too.
  </p>
  <ul class="tool-list">
    {
      tools.map(({ href, name, description, Icon }) => (
        <li>
          <a href={href}>
            <Icon width={28} height={28} aria-hidden="true" />
            <span>{name}</span>
          </a>
          <p class="text-muted-foreground">{description}</p>
        </li>
      ))
    }
  </ul>
</ToolLayout>

<style>
  .tool-list {
    list-style: none;
    padding: 0;
    margin: 2em 0 0;
    display: grid;
    gap: 1.25em;
  }
  .tool-list li {
    margin: 0;
  }
  .tool-list a {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    font-weight: 600;
    text-decoration: none;
  }
  .tool-list a:hover {
    text-decoration: underline;
  }
  .tool-list p {
    margin: 0.25em 0 0 2.4em;
    font-size: 0.95em;
  }
</style>
